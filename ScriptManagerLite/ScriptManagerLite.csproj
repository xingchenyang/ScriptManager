    <RootNamespace>ScriptManager</RootNamespace>
    <LangVersion>7.3</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="log4net" Version="3.4.0" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Config\Database.config" CopyToOutputDirectory="PreserveNewest" />
